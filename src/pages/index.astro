---
import PanelReveal from "../components/motion/PanelReveal.astro";
import AboutMilestones from "../components/sections/AboutMilestones.astro";
import Hero from "../components/sections/Hero.astro";
import Marquee from "../components/sections/Marquee.astro";
import Navigation from "../components/sections/Navigation.astro";
import ProjectsExperiences from "../components/sections/ProjectsExperiences.astro";
import ServicesIntro from "../components/sections/ServicesIntro.astro";
import StickyServices from "../components/sections/StickyServices.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="MOSAÏQUE EVENTS — Eventos en Montréal"
  description="Empresa integral de eventos en Montréal especializada en organización, producción, montaje y experiencias."
>
  <Navigation />
  <main>
    <Hero />
    <AboutMilestones />
    <WhyChooseUs />
    <Marquee />
    <PanelReveal>
      <ServicesIntro slot="lead" />
      <StickyServices />
    </PanelReveal>
    <ProjectsExperiences />
  </main>
</BaseLayout>
