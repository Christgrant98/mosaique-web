---
import Heading from "../ui/Heading.astro";
import { testimonialsContent } from "../../content/home/testimonials";

import "../../styles/sections/testimonials.css";
---

<div
  class="testimonials"
  id="testimonials"
  role="region"
  aria-labelledby="testimonials-title"
  data-content-status={testimonialsContent.status}
>
  <Heading as="h2" variant="heading-lg" id="testimonials-title" class="visually-hidden">
    {testimonialsContent.title}
  </Heading>

  <ol class="testimonials__list">
    {
      testimonialsContent.items.map((testimonial, index) => (
        <li class="testimonials__item">
          <figure
            class="testimonials__media"
            data-media-status="pending"
            data-tone={String(index + 1).padStart(2, "0")}
            aria-hidden="true"
          >
            <span />
            <span />
          </figure>

          <blockquote>
            <cite>{testimonial.name}</cite>
            <p>“{testimonial.quote}”</p>
          </blockquote>
        </li>
      ))
    }
  </ol>
</div>
