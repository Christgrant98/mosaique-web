---
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import Stack from "../ui/Stack.astro";
import Text from "../ui/Text.astro";

import "../../styles/sections/services-spike.css";
---

<Section class="services-spike__intro">
  <Container>
    <Stack gap="content" class="max-w-[var(--layout-max-reading)]">
      <Text as="span" variant="caption" tone="secondary">Servicios</Text>
      <Heading as="h2" variant="display-lg">Cada evento comienza con una intención.</Heading>
      <Text variant="body-lg">
        La convertimos en una experiencia clara, cuidada y memorable, desde la primera idea hasta
        el último detalle.
      </Text>
    </Stack>
  </Container>
</Section>
