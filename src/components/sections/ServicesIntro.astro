---
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import Stack from "../ui/Stack.astro";
import Text from "../ui/Text.astro";
import { servicesContent } from "../../content/home/services";

import "../../styles/sections/services-spike.css";
---

<Section class="services-spike__intro">
  <Container>
    <Stack gap="content" class="max-w-[var(--layout-max-reading)]">
      <Heading as="h2" variant="display-lg">{servicesContent.intro.title}</Heading>
      <Text variant="body-lg">{servicesContent.intro.text}</Text>
      <Text>{servicesContent.intro.highlight}</Text>
    </Stack>
  </Container>
</Section>
