---
import { heroContent } from "../../content/home/hero";

import "../../styles/sections/home-entry.css";

const [heroBrand, heroCategory] = heroContent.brand.split(" ");
---

<section class="home-hero" id="top" aria-label={heroContent.brand}>
  <p class="home-hero__brand" aria-hidden="true">
    <span>{heroBrand}</span>
    <span>{heroCategory}</span>
  </p>

  <div class="home-hero__scene">
    <figure
      class="home-hero__media"
      data-media-status={heroContent.media.status}
      style={`--home-hero-media-position:${heroContent.media.position};`}
    >
      {
        heroContent.media.src ? (
          <img src={heroContent.media.src} alt={heroContent.media.alt} loading="eager" />
        ) : (
          <div class="home-hero__media-placeholder" aria-hidden="true">
            <span />
            <span />
          </div>
        )
      }
      <figcaption>{heroContent.overlay}</figcaption>
    </figure>
  </div>
</section>

<script>
  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
  const rangeProgress = (progress: number, start: number, end: number) =>
    clamp((progress - start) / (end - start));

  document.querySelectorAll<HTMLElement>(".home-hero").forEach((hero) => {
    if (hero.dataset.scrollMotionReady === "true") return;

    hero.dataset.scrollMotionReady = "true";

    const navigation = document.querySelector<HTMLElement>(".site-navigation");
    const heroBrand = hero.querySelector<HTMLElement>(".home-hero__brand");
    const navigationBrand = navigation?.querySelector<HTMLElement>(".site-navigation__brand");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    let frameId = 0;

    const update = () => {
      frameId = 0;

      if (reducedMotion.matches) {
        navigation?.style.removeProperty("--hero-nav-brand-opacity");
        return;
      }

      const heroTop = hero.getBoundingClientRect().top + window.scrollY;
      const scrollRange = Math.max(window.innerHeight * 0.55, 1);
      const progress = clamp((window.scrollY - heroTop) / scrollRange);
      const brandProgress = rangeProgress(progress, 0, 0.58);
      const brandHandoffProgress = rangeProgress(progress, 0.56, 0.64);
      const captionProgress = rangeProgress(progress, 0.64, 0.88);

      if (heroBrand && navigationBrand) {
        const navigationBrandRect = navigationBrand.getBoundingClientRect();
        const heroBrandCenter = heroBrand.offsetTop + heroBrand.offsetHeight / 2;
        const navigationBrandCenter = navigationBrandRect.top + navigationBrandRect.height / 2;
        const targetScale = navigationBrandRect.width / heroBrand.offsetWidth;

        hero.style.setProperty("--hero-brand-opacity", String(1 - brandHandoffProgress));
        hero.style.setProperty(
          "--hero-brand-y",
          `${(navigationBrandCenter - heroBrandCenter) * brandProgress}px`,
        );
        hero.style.setProperty(
          "--hero-brand-scale",
          String(1 - (1 - targetScale) * brandProgress),
        );
        navigation?.style.setProperty("--hero-nav-brand-opacity", String(brandHandoffProgress));
      }

      hero.style.setProperty("--hero-caption-opacity", String(captionProgress));
      navigation?.style.setProperty("--hero-nav-progress", `${brandProgress * 100}%`);
    };

    const requestUpdate = () => {
      if (!frameId) frameId = window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", requestUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", requestUpdate, { signal: controller.signal });
    reducedMotion.addEventListener("change", requestUpdate, { signal: controller.signal });
    window.addEventListener(
      "pagehide",
      () => {
        controller.abort();
        if (frameId) window.cancelAnimationFrame(frameId);
      },
      { once: true },
    );

    update();
  });
</script>
