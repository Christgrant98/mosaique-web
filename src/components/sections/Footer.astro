---
import Container from "../ui/Container.astro";
import { footerContent } from "../../content/home/footer";

import "../../styles/sections/footer.css";

const [footerBrand, ...footerCategoryParts] = footerContent.logo.split(" ");
const footerCategory = footerCategoryParts.join(" ");
const primaryLinks = footerContent.links.slice(0, 4);
const secondaryLinks = footerContent.links.slice(4);
const serviceColumns = [
  footerContent.services.slice(0, 2),
  footerContent.services.slice(2, 4),
  footerContent.services.slice(4, 6),
];
---

<footer class="site-footer" id="footer" aria-labelledby="footer-brand">
  <Container bleed class="site-footer__container">
    <h2 class="site-footer__sr-only" id="footer-brand">{footerContent.logo}</h2>

    <div class="site-footer__top">
      <nav class="site-footer__navigation" aria-label="Navegación del pie de página">
        <div>
          <h3>Compañía</h3>
          <ul>
            {
              primaryLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3>Recursos</h3>
          <ul>
            {
              secondaryLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3>Servicios</h3>
          <ul>
            {footerContent.services.slice(0, 3).map((service) => <li>{service}</li>)}
          </ul>
        </div>
      </nav>

      <div class="site-footer__logo-wall" aria-hidden="true">
        <div class="site-footer__logo-tile site-footer__logo-mark">M</div>
        <div class="site-footer__logo-tile site-footer__logo-name">{footerBrand}</div>
        <div class="site-footer__logo-tile site-footer__logo-category">{footerCategory}</div>
      </div>
    </div>

    <div class="site-footer__middle">
      <div class="site-footer__contact-lead">
        <h3>{footerContent.contact.purpose}</h3>
        <p>{footerContent.description}</p>
        <a class="site-footer__contact-action" href={footerContent.contact.email.href}>
          <span>{footerContent.contact.email.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="site-footer__details">
        <address class="site-footer__contact">
          <div>
            <span>Teléfono</span>
            <a href={footerContent.contact.phone.href}>{footerContent.contact.phone.label}</a>
          </div>
          <div>
            <span>Email</span>
            <a href={footerContent.contact.email.href}>{footerContent.contact.email.label}</a>
          </div>
          <div>
            <span>Ubicación</span>
            <p>{footerContent.contact.location}</p>
          </div>
        </address>

        <div class="site-footer__service-columns">
          {
            serviceColumns.map((services) => (
              <ul>
                {services.map((service) => (
                  <li>{service}</li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>{footerContent.closingStatement}</p>
      <p>{footerContent.legal}</p>
    </div>
  </Container>
</footer>
