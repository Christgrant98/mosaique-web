---
import { quoteContent } from "../../content/home/quote";
---

<section class="quote-step" data-quote-step="1" aria-labelledby="quote-event-title" hidden>
  <header>
    <span>02</span>
    <h2 id="quote-event-title" tabindex="-1">Tu evento</h2>
  </header>

  <div class="quote-fields">
    <label class="quote-field quote-field--wide">
      <span>Servicio de interés <strong aria-hidden="true">*</strong></span>
      <select
        name="service"
        required
        aria-describedby="quote-service-error"
        data-error-required="Selecciona un servicio."
      >
        <option value="">Selecciona una opción</option>
        {
          quoteContent.services.map((service) => (
            <option value={service.value}>{service.label}</option>
          ))
        }
      </select>
      <small id="quote-service-error" data-quote-error></small>
    </label>

    <label class="quote-field quote-field--wide">
      <span>Tipo de evento <strong aria-hidden="true">*</strong></span>
      <select
        name="eventType"
        required
        aria-describedby="quote-event-type-error"
        data-error-required="Selecciona el tipo de evento."
      >
        <option value="">Selecciona una opción</option>
        {
          quoteContent.eventTypes.map((eventType) => (
            <option value={eventType}>{eventType}</option>
          ))
        }
      </select>
      <small id="quote-event-type-error" data-quote-error></small>
    </label>

    <div
      class="quote-date-group quote-field--wide"
      role="group"
      aria-labelledby="quote-event-date-label"
    >
      <label class="quote-field quote-date-group__date">
        <span id="quote-event-date-label">Fecha del evento</span>
        <input type="hidden" name="eventDate" />
        <button
          type="button"
          class="quote-date-trigger"
          data-date-trigger
          aria-haspopup="dialog"
          aria-controls="date-picker-dialog"
          aria-describedby="quote-event-date-help"
        >
          <span data-date-value>Seleccionar fecha</span>
          <span aria-hidden="true">▢</span>
        </button>
        <small id="quote-event-date-help">Opcional si todavía no está definida.</small>
      </label>

      <label class="quote-check quote-date-group__unknown">
        <input type="checkbox" name="dateUnknown" />
        <span>Aún no tengo fecha</span>
      </label>
    </div>

    <label class="quote-field quote-field--wide">
      <span>Número aproximado de invitados <strong aria-hidden="true">*</strong></span>
      <select
        name="guestRange"
        required
        aria-describedby="quote-guests-error"
        data-error-required="Selecciona un rango de invitados."
      >
        <option value="">Selecciona una opción</option>
        {quoteContent.guestRanges.map((range) => <option value={range}>{range}</option>)}
      </select>
      <small id="quote-guests-error" data-quote-error></small>
    </label>
  </div>
</section>
