---
import { quoteContent } from "../../content/home/quote";
---

<div class="quote-stepper" aria-label="Progreso de la solicitud">
  <p class="quote-stepper__compact" data-quote-step-compact>
    Paso 1 de {quoteContent.steps.length} · {quoteContent.steps[0].label}
  </p>
  <ol>
    {
      quoteContent.steps.map((step, index) => (
        <li data-quote-step-indicator={index} data-state={index === 0 ? "active" : "pending"}>
          <span data-quote-step-mark>{step.index}</span>
          <strong>{step.label}</strong>
        </li>
      ))
    }
  </ol>
</div>
