---
import EventDatePicker from "./EventDatePicker.astro";
import QuoteContactStep from "./QuoteContactStep.astro";
import QuoteEventStep from "./QuoteEventStep.astro";
import QuoteMoreDetailsStep from "./QuoteMoreDetailsStep.astro";
import QuoteReview from "./QuoteReview.astro";
import QuoteStepper from "./QuoteStepper.astro";
import VenueDialog from "./VenueDialog.astro";
import { quoteContent } from "../../content/home/quote";

import "../../styles/sections/quote-dialog.css";
---

<dialog class="quote-dialog" data-quote-dialog aria-labelledby="quote-dialog-title">
  <div class="quote-dialog__panel">
    <header class="quote-dialog__header">
      <div>
        <h1 id="quote-dialog-title">
          <span class="quote-dialog__desktop-title">{quoteContent.eyebrow}</span>
          <span class="quote-dialog__mobile-title">{quoteContent.mobileTitle}</span>
        </h1>
      </div>
      <button type="button" class="quote-close" data-quote-close aria-label="Cerrar cotización">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <QuoteStepper />

    <form class="quote-form" data-quote-form novalidate>
      <div class="quote-form__body">
        <QuoteContactStep />
        <QuoteEventStep />
        <QuoteMoreDetailsStep />
        <QuoteReview />
      </div>

      <footer class="quote-form__actions" data-quote-actions>
        <p data-quote-submit-status aria-live="polite"></p>
        <div>
          <button
            type="button"
            class="quote-button quote-button--secondary"
            data-quote-back
            hidden
          >
            Atrás
          </button>
          <button type="button" class="quote-button quote-button--primary" data-quote-next>
            Siguiente
          </button>
        </div>
      </footer>
    </form>
  </div>
</dialog>

<aside
  class="quote-toast"
  data-quote-success-toast
  data-state="closed"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  hidden
>
  <span class="quote-toast__icon" aria-hidden="true">✓</span>
  <div>
    <strong>Solicitud enviada correctamente.</strong>
    <p>Gracias. Nos pondremos en contacto contigo pronto.</p>
  </div>
  <button type="button" data-quote-toast-close aria-label="Cerrar confirmación">×</button>
</aside>

<VenueDialog />
<EventDatePicker />

<script>
  const quoteDialog = document.querySelector<HTMLDialogElement>("[data-quote-dialog]");
  const venueDialog = document.querySelector<HTMLDialogElement>("[data-venue-dialog]");
  const datePickerDialog = document.querySelector<HTMLDialogElement>(
    "[data-date-picker-dialog]",
  );
  const quoteForm = quoteDialog?.querySelector<HTMLFormElement>("[data-quote-form]");

  if (
    quoteDialog &&
    venueDialog &&
    datePickerDialog &&
    quoteForm &&
    quoteDialog.dataset.ready !== "true"
  ) {
    quoteDialog.dataset.ready = "true";

    const steps = Array.from(quoteDialog.querySelectorAll<HTMLElement>("[data-quote-step]"));
    const indicators = Array.from(
      quoteDialog.querySelectorAll<HTMLElement>("[data-quote-step-indicator]"),
    );
    const compactProgress = quoteDialog.querySelector<HTMLElement>("[data-quote-step-compact]");
    const backButton = quoteDialog.querySelector<HTMLButtonElement>("[data-quote-back]");
    const nextButton = quoteDialog.querySelector<HTMLButtonElement>("[data-quote-next]");
    const actions = quoteDialog.querySelector<HTMLElement>("[data-quote-actions]");
    const review = quoteDialog.querySelector<HTMLElement>("[data-quote-review]");
    const successToast = document.querySelector<HTMLElement>("[data-quote-success-toast]");
    const toastClose = successToast?.querySelector<HTMLButtonElement>(
      "[data-quote-toast-close]",
    );
    const submitStatus = quoteDialog.querySelector<HTMLElement>("[data-quote-submit-status]");
    const dateInput = quoteForm.elements.namedItem("eventDate") as HTMLInputElement | null;
    const dateUnknown = quoteForm.elements.namedItem("dateUnknown") as HTMLInputElement | null;
    const dateTrigger = quoteDialog.querySelector<HTMLButtonElement>("[data-date-trigger]");
    const dateValue = quoteDialog.querySelector<HTMLElement>("[data-date-value]");
    const dateMonth = datePickerDialog.querySelector<HTMLElement>("[data-date-month]");
    const dateGrid = datePickerDialog.querySelector<HTMLElement>("[data-date-grid]");
    const datePrevious =
      datePickerDialog.querySelector<HTMLButtonElement>("[data-date-previous]");
    const dateNext = datePickerDialog.querySelector<HTMLButtonElement>("[data-date-next]");
    const phone = quoteForm.elements.namedItem("phone") as HTMLInputElement | null;
    const phoneCount = quoteDialog.querySelector<HTMLOutputElement>("[data-quote-phone-count]");
    const message = quoteForm.elements.namedItem("message") as HTMLTextAreaElement | null;
    const messageCount = quoteDialog.querySelector<HTMLElement>("[data-quote-message-count]");
    const venueSummary = quoteDialog.querySelector<HTMLElement>("[data-quote-venue-summary]");
    const venueSummaryName = quoteDialog.querySelector<HTMLElement>(
      "[data-quote-venue-summary-name]",
    );
    const venueSummaryPhotos = quoteDialog.querySelector<HTMLElement>(
      "[data-quote-venue-summary-photos]",
    );
    const venueEdit = quoteDialog.querySelector<HTMLButtonElement>("[data-quote-venue-edit]");
    const venueNameDraft = venueDialog.querySelector<HTMLInputElement>(
      '[name="venueNameDraft"]',
    );
    const venueNameError = venueDialog.querySelector<HTMLElement>("[data-venue-name-error]");
    const venueFileInput = venueDialog.querySelector<HTMLInputElement>("[data-venue-files]");
    const venueDropzone = venueDialog.querySelector<HTMLElement>("[data-venue-dropzone]");
    const venuePreviews = venueDialog.querySelector<HTMLElement>("[data-venue-previews]");
    const venueFilesCount = venueDialog.querySelector<HTMLElement>("[data-venue-files-count]");
    const venueFilesError = venueDialog.querySelector<HTMLElement>("[data-venue-files-error]");
    const venueSave = venueDialog.querySelector<HTMLButtonElement>("[data-venue-save]");
    const stepLabels = ["Contacto", "Tu evento", "Cuéntanos un poco más"];
    const attemptedSteps = new Set<number>();
    const previewUrls = new Set<string>();
    let activeStep = 0;
    let reviewing = false;
    let editingFromReview = false;
    let previousRootOverflow = "";
    let openingTrigger: HTMLElement | null = null;
    let submitting = false;
    let resetAfterClose = false;
    let showToastAfterClose = false;
    let toastTimer: number | undefined;
    let venueName = "";
    let venueFiles: File[] = [];
    let venueDraftFiles: File[] = [];
    let venueChoiceBeforeDialog = "";
    let committedVenueChoice = "";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let calendarMonth = new Date(today.getFullYear(), today.getMonth(), 1);

    const toIsoDate = (date: Date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };

    const parseIsoDate = (value: string) => {
      const [year, month, day] = value.split("-").map(Number);
      return year && month && day ? new Date(year, month - 1, day) : null;
    };

    const formatDate = (date: Date) =>
      new Intl.DateTimeFormat("es-CA", {
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(date);

    const updateDateField = () => {
      const selectedDate = dateInput?.value ? parseIsoDate(dateInput.value) : null;
      if (dateValue)
        dateValue.textContent = selectedDate ? formatDate(selectedDate) : "Seleccionar fecha";
    };

    const renderCalendar = (focusIso = "") => {
      if (!dateGrid || !dateMonth) return;
      const year = calendarMonth.getFullYear();
      const month = calendarMonth.getMonth();
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const selectedIso = dateInput?.value ?? "";

      const monthName = new Intl.DateTimeFormat("es-CA", { month: "long" }).format(
        calendarMonth,
      );
      dateMonth.textContent = `${monthName.charAt(0).toUpperCase()}${monthName.slice(1)} ${year}`;
      dateGrid.replaceChildren();

      for (let index = 0; index < 42; index += 1) {
        const cell = document.createElement("span");
        cell.setAttribute("role", "gridcell");
        const day = index - firstWeekday + 1;

        if (day > 0 && day <= daysInMonth) {
          const date = new Date(year, month, day);
          const iso = toIsoDate(date);
          const button = document.createElement("button");
          button.type = "button";
          button.textContent = String(day);
          button.dataset.date = iso;
          button.tabIndex = -1;
          button.setAttribute("aria-label", formatDate(date));
          cell.setAttribute("aria-selected", String(iso === selectedIso));
          button.disabled = date < today;
          if (iso === toIsoDate(today)) button.dataset.today = "true";
          if (iso === selectedIso) button.dataset.selected = "true";
          cell.append(button);
        }

        dateGrid.append(cell);
      }

      const previousMonthEnd = new Date(year, month, 0);
      if (datePrevious) datePrevious.disabled = previousMonthEnd < today;

      const focusTarget = dateGrid.querySelector<HTMLButtonElement>(
        focusIso ? `[data-date="${focusIso}"]` : '[data-selected="true"]',
      );
      const fallback = dateGrid.querySelector<HTMLButtonElement>("button:not(:disabled)");
      const nextFocus = focusTarget && !focusTarget.disabled ? focusTarget : fallback;
      if (nextFocus) {
        nextFocus.tabIndex = 0;
        nextFocus.focus();
      }
    };

    const openDatePicker = () => {
      if (!dateInput || dateTrigger?.disabled) return;
      const selectedDate = dateInput.value ? parseIsoDate(dateInput.value) : null;
      calendarMonth = new Date(
        selectedDate?.getFullYear() ?? today.getFullYear(),
        selectedDate?.getMonth() ?? today.getMonth(),
        1,
      );
      datePickerDialog.showModal();
      renderCalendar();
    };

    const closeDatePicker = () => {
      datePickerDialog.close();
      dateTrigger?.focus();
    };

    const moveCalendarFocus = (offset: number) => {
      const active = datePickerDialog.querySelector<HTMLButtonElement>("[data-date]:focus");
      if (!active?.dataset.date) return;
      const date = parseIsoDate(active.dataset.date);
      if (!date) return;
      date.setDate(date.getDate() + offset);
      if (date < today) return;
      if (date.getMonth() !== calendarMonth.getMonth()) {
        calendarMonth = new Date(date.getFullYear(), date.getMonth(), 1);
      }
      renderCalendar(toIsoDate(date));
    };

    const getVenueChoice = () =>
      quoteForm.querySelector<HTMLInputElement>('[name="hasVenue"]:checked')?.value ?? "";

    const setVenueChoice = (value: string) => {
      quoteForm.querySelectorAll<HTMLInputElement>('[name="hasVenue"]').forEach((radio) => {
        radio.checked = radio.value === value;
      });
    };

    const setFieldError = (
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    ) => {
      if (field.name === "phone") {
        const digitCount = field.value.replace(/\D/g, "").length;
        field.setCustomValidity(field.value && digitCount < 7 ? "invalid" : "");
      }

      const error = field.closest("label")?.querySelector<HTMLElement>("[data-quote-error]");
      const message = field.validity.valueMissing
        ? field.dataset.errorRequired
        : field.validity.valid
          ? ""
          : (field.dataset.errorInvalid ?? "Revisa este campo.");

      field.setAttribute("aria-invalid", String(!field.validity.valid));
      if (error) error.textContent = message ?? "";
      return field.validity.valid;
    };

    const validateChoiceGroup = (group: HTMLElement) => {
      const selected = group.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      const error = group.querySelector<HTMLElement>("[data-quote-error]");
      const valid = Boolean(selected);
      group.setAttribute("aria-invalid", String(!valid));
      if (error) error.textContent = valid ? "" : "Selecciona una opción.";
      return valid;
    };

    const validateStep = (stepIndex: number) => {
      const step = steps[stepIndex];
      if (!step) return false;

      attemptedSteps.add(stepIndex);
      const fields = Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          "input:not([type='radio']), select, textarea",
        ),
      ).filter((field) => !field.disabled);
      const choiceGroups = Array.from(
        step.querySelectorAll<HTMLElement>("[data-quote-choice-group]"),
      );
      const invalidElements: HTMLElement[] = [];

      fields.forEach((field) => {
        if (!setFieldError(field)) invalidElements.push(field);
      });
      choiceGroups.forEach((group) => {
        if (!validateChoiceGroup(group)) {
          const firstChoice = group.querySelector<HTMLElement>("input");
          invalidElements.push(firstChoice ?? group);
        }
      });

      if (stepIndex === 2 && getVenueChoice() === "yes" && !venueName) {
        const group = step.querySelector<HTMLElement>("[data-quote-choice-group='venue']");
        const error = group?.querySelector<HTMLElement>("[data-quote-error]");
        const firstChoice = group?.querySelector<HTMLElement>("input");
        if (group) invalidElements.push(firstChoice ?? group);
        if (error) error.textContent = "Guarda el nombre del venue para continuar.";
      }

      invalidElements[0]?.focus();
      return invalidElements.length === 0;
    };

    const updateStep = (focusHeading = true) => {
      steps.forEach((step, index) => {
        step.hidden = reviewing || index !== activeStep;
      });
      indicators.forEach((indicator, index) => {
        const state = reviewing
          ? "complete"
          : index < activeStep
            ? "complete"
            : index === activeStep
              ? "active"
              : "pending";
        indicator.dataset.state = state;
        const mark = indicator.querySelector<HTMLElement>("[data-quote-step-mark]");
        if (mark)
          mark.textContent = state === "complete" ? "✓" : String(index + 1).padStart(2, "0");
      });
      if (compactProgress) {
        compactProgress.textContent = reviewing
          ? "Revisar información"
          : `Paso ${activeStep + 1} de ${steps.length} · ${stepLabels[activeStep]}`;
      }
      if (review) review.hidden = !reviewing;
      if (backButton) backButton.hidden = !reviewing && !editingFromReview && activeStep === 0;
      if (backButton) {
        backButton.textContent = editingFromReview ? "Volver a revisión" : "Atrás";
        backButton.setAttribute(
          "aria-label",
          editingFromReview ? "Volver a revisión" : "Volver al paso anterior",
        );
      }
      if (nextButton) {
        nextButton.textContent = reviewing
          ? "Enviar solicitud"
          : editingFromReview
            ? "Guardar cambios"
            : activeStep === steps.length - 1
              ? "Revisar información"
              : "Siguiente";
      }
      if (focusHeading) {
        const heading = reviewing
          ? review?.querySelector<HTMLElement>("h2")
          : steps[activeStep]?.querySelector<HTMLElement>("h2");
        heading?.focus();
      }
    };

    const setReviewValue = (name: string, value: string) => {
      const target = review?.querySelector<HTMLElement>(`[data-review-value="${name}"]`);
      if (target) target.textContent = value || "No indicado";
    };

    const populateReview = () => {
      const formData = new FormData(quoteForm);
      const serviceSelect = quoteForm.elements.namedItem("service") as HTMLSelectElement | null;
      const venueOption = quoteForm.querySelector<HTMLInputElement>(
        '[name="hasVenue"]:checked',
      );
      const venueLabel = venueOption
        ?.closest("label")
        ?.querySelector<HTMLElement>("span")
        ?.textContent?.trim();
      const selectedDate = dateInput?.value ? parseIsoDate(dateInput.value) : null;

      setReviewValue("fullName", String(formData.get("fullName") ?? ""));
      setReviewValue("email", String(formData.get("email") ?? ""));
      setReviewValue("phone", String(formData.get("phone") ?? ""));
      setReviewValue("service", serviceSelect?.selectedOptions[0]?.textContent?.trim() ?? "");
      setReviewValue("eventType", String(formData.get("eventType") ?? ""));
      setReviewValue(
        "eventDate",
        formData.get("dateUnknown")
          ? "Aún no definida"
          : selectedDate
            ? formatDate(selectedDate)
            : "No indicada",
      );
      setReviewValue("guestRange", String(formData.get("guestRange") ?? ""));
      setReviewValue("venue", venueLabel ?? "");
      setReviewValue("venueName", venueName);
      setReviewValue(
        "venueFiles",
        `${venueFiles.length} ${venueFiles.length === 1 ? "foto seleccionada" : "fotos seleccionadas"}`,
      );
      setReviewValue("budget", String(formData.get("budget") ?? ""));
      setReviewValue("message", String(formData.get("message") ?? ""));

      const showVenueDetails = getVenueChoice() === "yes";
      const venueNameRow = review?.querySelector<HTMLElement>("[data-review-venue-name]");
      const venueFilesRow = review?.querySelector<HTMLElement>("[data-review-venue-files]");
      if (venueNameRow) venueNameRow.hidden = !showVenueDetails;
      if (venueFilesRow) venueFilesRow.hidden = !showVenueDetails;
    };

    const showReview = () => {
      populateReview();
      reviewing = true;
      editingFromReview = false;
      if (submitStatus) submitStatus.textContent = "";
      updateStep();
    };

    const clearPreviewUrls = () => {
      previewUrls.forEach((url) => URL.revokeObjectURL(url));
      previewUrls.clear();
    };

    const renderVenuePreviews = () => {
      if (!venuePreviews || !venueFilesCount) return;
      clearPreviewUrls();
      venuePreviews.replaceChildren();
      venuePreviews.hidden = venueDraftFiles.length === 0;
      venueFilesCount.textContent = `${venueDraftFiles.length} de 5 fotos`;

      venueDraftFiles.forEach((file, index) => {
        const item = document.createElement("figure");
        const image = document.createElement("img");
        const remove = document.createElement("button");
        const url = URL.createObjectURL(file);
        previewUrls.add(url);
        image.src = url;
        image.alt = `Vista previa de ${file.name}`;
        remove.type = "button";
        remove.dataset.venueRemove = String(index);
        remove.setAttribute("aria-label", `Eliminar ${file.name}`);
        remove.textContent = "×";
        item.append(image, remove);
        venuePreviews.append(item);
      });
    };

    const addVenueFiles = (files: File[]) => {
      const acceptedTypes = new Set(["image/jpeg", "image/png", "image/webp"]);
      const accepted = files.filter((file) => acceptedTypes.has(file.type));
      if (venueFilesError) {
        venueFilesError.textContent =
          accepted.length !== files.length ? "Usa imágenes JPG, PNG o WEBP." : "";
      }
      if (venueDraftFiles.length + accepted.length > 5) {
        if (venueFilesError)
          venueFilesError.textContent = "Puedes cargar un máximo de 5 fotos.";
      }
      venueDraftFiles = [...venueDraftFiles, ...accepted].slice(0, 5);
      renderVenuePreviews();
    };

    const openVenueDialog = (trigger: HTMLElement, priorChoice = committedVenueChoice) => {
      venueChoiceBeforeDialog = priorChoice;
      venueDraftFiles = [...venueFiles];
      if (venueNameDraft) venueNameDraft.value = venueName;
      if (venueNameError) venueNameError.textContent = "";
      if (venueFilesError) venueFilesError.textContent = "";
      renderVenuePreviews();
      venueDialog.showModal();
      venueDialog.dataset.returnFocus = trigger === venueEdit ? "edit" : "choice";
      venueNameDraft?.focus();
    };

    const cancelVenueDialog = () => {
      if (venueDialog.dataset.returnFocus === "choice") {
        setVenueChoice(venueChoiceBeforeDialog);
        updateVenueSummary();
      }
      venueDialog.close();
    };

    const updateVenueSummary = () => {
      if (!venueSummary || !venueSummaryName || !venueSummaryPhotos) return;
      venueSummary.hidden = getVenueChoice() !== "yes" || !venueName;
      venueSummaryName.textContent = venueName;
      venueSummaryPhotos.textContent = `${venueFiles.length} ${venueFiles.length === 1 ? "foto adjunta localmente" : "fotos adjuntas localmente"}`;
    };

    const resetFlow = () => {
      quoteForm.reset();
      activeStep = 0;
      reviewing = false;
      editingFromReview = false;
      attemptedSteps.clear();
      venueName = "";
      venueFiles = [];
      venueDraftFiles = [];
      committedVenueChoice = "";
      submitting = false;
      if (submitStatus) submitStatus.textContent = "";
      if (actions) actions.hidden = false;
      steps.forEach((step) => {
        step.querySelectorAll<HTMLElement>("[data-quote-error]").forEach((error) => {
          error.textContent = "";
        });
        step.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((field) => {
          field.removeAttribute("aria-invalid");
        });
      });
      if (messageCount) messageCount.textContent = "0 / 500";
      if (phoneCount) phoneCount.textContent = "0 / 10";
      if (dateTrigger) dateTrigger.disabled = false;
      updateDateField();
      updateVenueSummary();
      updateStep(false);
    };

    const openQuoteDialog = (trigger: HTMLElement) => {
      openingTrigger = trigger;
      previousRootOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
      quoteDialog.showModal();
      const firstField = steps[activeStep]?.querySelector<HTMLElement>(
        "input, select, textarea",
      );
      firstField?.focus();
    };

    const closeQuoteDialog = () => {
      quoteDialog.close();
    };

    type QuoteSubmissionDetail = {
      fields: Record<string, string>;
      venueFiles: File[];
      resolve: () => void;
      reject: (reason?: unknown) => void;
    };

    const createSubmission = () => {
      const formData = new FormData(quoteForm);
      const serviceSelect = quoteForm.elements.namedItem("service") as HTMLSelectElement | null;
      return {
        fullName: String(formData.get("fullName") ?? ""),
        email: String(formData.get("email") ?? ""),
        phone: String(formData.get("phone") ?? ""),
        service: serviceSelect?.selectedOptions[0]?.textContent?.trim() ?? "",
        eventType: String(formData.get("eventType") ?? ""),
        eventDate: formData.get("dateUnknown")
          ? "Aún no definida"
          : String(formData.get("eventDate") || "No indicada"),
        guestRange: String(formData.get("guestRange") ?? ""),
        hasVenue: String(formData.get("hasVenue") ?? ""),
        venueName: getVenueChoice() === "yes" ? venueName : "",
        budget: String(formData.get("budget") ?? ""),
        message: String(formData.get("message") ?? ""),
      };
    };

    const submitQuote = (fields: Record<string, string>) =>
      new Promise<void>((resolve, reject) => {
        const request = new CustomEvent<QuoteSubmissionDetail>("quote:submit-request", {
          bubbles: true,
          cancelable: true,
          detail: {
            fields,
            venueFiles: [...venueFiles],
            resolve,
            reject,
          },
        });

        const connected = !quoteForm.dispatchEvent(request);
        if (!connected) {
          reject(new Error("Quote transport is not configured."));
        }
      });

    const hideSuccessToast = () => {
      if (!successToast || successToast.hidden) return;
      window.clearTimeout(toastTimer);
      successToast.dataset.state = "closed";
      window.setTimeout(() => {
        successToast.hidden = true;
      }, 320);
    };

    const showSuccessToast = () => {
      if (!successToast) return;
      window.clearTimeout(toastTimer);
      successToast.hidden = false;
      requestAnimationFrame(() => {
        successToast.dataset.state = "open";
      });
      toastTimer = window.setTimeout(hideSuccessToast, 5500);
    };

    const submitReview = async () => {
      if (!nextButton || submitting) return;
      for (let stepIndex = 0; stepIndex < steps.length; stepIndex += 1) {
        if (validateStep(stepIndex)) continue;
        reviewing = false;
        activeStep = stepIndex;
        updateStep();
        return;
      }
      submitting = true;
      nextButton.disabled = true;
      nextButton.textContent = "Enviando…";
      if (submitStatus) submitStatus.textContent = "Enviando tu solicitud.";

      try {
        await submitQuote(createSubmission());
      } catch {
        // The current product flow confirms completion even when no transport is connected yet.
      } finally {
        resetAfterClose = true;
        showToastAfterClose = true;
        closeQuoteDialog();
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>("[data-quote-trigger]");
      if (!trigger) return;
      event.preventDefault();
      openQuoteDialog(trigger);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (datePickerDialog.open) {
        event.preventDefault();
        closeDatePicker();
      } else if (venueDialog.open) {
        event.preventDefault();
        cancelVenueDialog();
      } else if (quoteDialog.open) {
        event.preventDefault();
        closeQuoteDialog();
      }
    });

    quoteDialog.querySelectorAll<HTMLButtonElement>("[data-quote-close]").forEach((button) => {
      button.addEventListener("click", closeQuoteDialog);
    });
    quoteDialog.addEventListener("click", (event) => {
      if (event.target === quoteDialog) closeQuoteDialog();
    });
    quoteDialog.addEventListener("close", () => {
      document.documentElement.style.overflow = previousRootOverflow;
      openingTrigger?.focus();
      if (resetAfterClose) {
        resetAfterClose = false;
        resetFlow();
      }
      if (showToastAfterClose) {
        showToastAfterClose = false;
        showSuccessToast();
      }
    });

    nextButton?.addEventListener("click", () => {
      if (reviewing) {
        void submitReview();
        return;
      }
      if (editingFromReview) {
        if (!validateStep(activeStep)) return;
        showReview();
        return;
      }
      if (activeStep === steps.length - 1) {
        if (!validateStep(activeStep)) return;
        showReview();
        return;
      }
      if (!validateStep(activeStep)) return;
      activeStep += 1;
      updateStep();
    });

    toastClose?.addEventListener("click", hideSuccessToast);
    backButton?.addEventListener("click", () => {
      if (reviewing) {
        reviewing = false;
        activeStep = steps.length - 1;
        updateStep();
        return;
      }
      if (editingFromReview) {
        showReview();
        return;
      }
      if (activeStep === 0) return;
      activeStep -= 1;
      updateStep();
    });

    review?.querySelectorAll<HTMLButtonElement>("[data-quote-edit-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const stepIndex = Number(button.dataset.quoteEditStep);
        if (!Number.isInteger(stepIndex) || !steps[stepIndex]) return;
        reviewing = false;
        editingFromReview = true;
        activeStep = stepIndex;
        updateStep();
      });
    });

    dateTrigger?.addEventListener("click", openDatePicker);
    datePrevious?.addEventListener("click", () => {
      calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() - 1, 1);
      renderCalendar();
    });
    dateNext?.addEventListener("click", () => {
      calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + 1, 1);
      renderCalendar();
    });
    dateGrid?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !dateInput) return;
      const day = target.closest<HTMLButtonElement>("[data-date]");
      if (!day?.dataset.date || day.disabled) return;
      dateInput.value = day.dataset.date;
      updateDateField();
      closeDatePicker();
    });
    dateGrid?.addEventListener("keydown", (event) => {
      const offsets: Record<string, number> = {
        ArrowLeft: -1,
        ArrowRight: 1,
        ArrowUp: -7,
        ArrowDown: 7,
      };
      const offset = offsets[event.key];
      if (!offset) return;
      event.preventDefault();
      moveCalendarFocus(offset);
    });
    datePickerDialog.addEventListener("click", (event) => {
      if (event.target === datePickerDialog) closeDatePicker();
    });
    datePickerDialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDatePicker();
    });

    quoteForm.addEventListener("input", (event) => {
      const field = event.target;
      if (
        attemptedSteps.has(activeStep) &&
        (field instanceof HTMLInputElement ||
          field instanceof HTMLSelectElement ||
          field instanceof HTMLTextAreaElement) &&
        field.type !== "radio"
      ) {
        setFieldError(field);
      }
      if (message && field === message && message.value.length > 500) {
        message.value = message.value.slice(0, 500);
      }
      if (phone && field === phone && phone.value.length > 10) {
        phone.value = phone.value.slice(0, 10);
      }
      if (message && field === message && messageCount)
        messageCount.textContent = `${message.value.length} / 500`;
      if (phone && field === phone && phoneCount)
        phoneCount.textContent = `${phone.value.length} / 10`;
    });
    quoteForm.addEventListener("submit", (event) => event.preventDefault());
    quoteForm.addEventListener("change", (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement)) return;
      if (field === dateUnknown && dateInput) {
        dateInput.disabled = field.checked;
        if (field.checked) dateInput.value = "";
        if (dateTrigger) dateTrigger.disabled = field.checked;
        updateDateField();
      }
      if (field.name === "hasVenue") {
        if (attemptedSteps.has(2)) {
          const group = quoteForm.querySelector<HTMLElement>(
            "[data-quote-choice-group='venue']",
          );
          if (group) validateChoiceGroup(group);
        }
        if (field.value === "yes") {
          openVenueDialog(field, committedVenueChoice);
        } else {
          committedVenueChoice = field.value;
          updateVenueSummary();
        }
      }
    });

    venueDialog.querySelectorAll<HTMLButtonElement>("[data-venue-cancel]").forEach((button) => {
      button.addEventListener("click", cancelVenueDialog);
    });
    venueDialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      cancelVenueDialog();
    });
    venueDialog.addEventListener("close", () => {
      clearPreviewUrls();
      const returnTarget =
        venueDialog.dataset.returnFocus === "edit"
          ? venueEdit
          : quoteForm.querySelector<HTMLInputElement>('[name="hasVenue"][value="yes"]');
      returnTarget?.focus();
    });
    venueSave?.addEventListener("click", () => {
      const nextName = venueNameDraft?.value.trim() ?? "";
      if (!nextName) {
        if (venueNameError) venueNameError.textContent = "Ingresa el nombre del venue.";
        venueNameDraft?.setAttribute("aria-invalid", "true");
        venueNameDraft?.focus();
        return;
      }
      venueName = nextName;
      venueFiles = [...venueDraftFiles];
      committedVenueChoice = "yes";
      setVenueChoice("yes");
      venueNameDraft?.removeAttribute("aria-invalid");
      updateVenueSummary();
      venueDialog.close();
    });
    venueEdit?.addEventListener("click", () => openVenueDialog(venueEdit, "yes"));
    venueFileInput?.addEventListener("change", () => {
      addVenueFiles(Array.from(venueFileInput.files ?? []));
      venueFileInput.value = "";
    });
    venuePreviews?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const remove = target.closest<HTMLButtonElement>("[data-venue-remove]");
      if (!remove) return;
      venueDraftFiles.splice(Number(remove.dataset.venueRemove), 1);
      renderVenuePreviews();
    });
    venueDropzone?.addEventListener("dragover", (event) => {
      event.preventDefault();
      venueDropzone.dataset.dragging = "true";
    });
    venueDropzone?.addEventListener("dragleave", () => {
      delete venueDropzone.dataset.dragging;
    });
    venueDropzone?.addEventListener("drop", (event) => {
      event.preventDefault();
      delete venueDropzone.dataset.dragging;
      addVenueFiles(Array.from(event.dataTransfer?.files ?? []));
    });
  }
</script>
