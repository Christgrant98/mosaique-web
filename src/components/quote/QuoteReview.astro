<section class="quote-review" data-quote-review aria-labelledby="quote-review-title" hidden>
  <header>
    <span>Revisión final</span>
    <h2 id="quote-review-title" tabindex="-1">Revisar y confirmar información</h2>
    <p>
      Verifica los detalles antes de preparar tu solicitud. Puedes editar cualquier sección.
    </p>
  </header>

  <div class="quote-review__sections">
    <section class="quote-review__section" aria-labelledby="quote-review-contact-title">
      <header>
        <div>
          <span>01</span>
          <h3 id="quote-review-contact-title">Contacto</h3>
        </div>
        <button type="button" class="quote-text-action" data-quote-edit-step="0">
          Editar <span class="sr-only">información de contacto</span>
        </button>
      </header>
      <dl>
        <div><dt>Nombre</dt><dd data-review-value="fullName"></dd></div>
        <div><dt>Email</dt><dd data-review-value="email"></dd></div>
        <div><dt>Teléfono</dt><dd data-review-value="phone"></dd></div>
      </dl>
    </section>

    <section class="quote-review__section" aria-labelledby="quote-review-event-title">
      <header>
        <div>
          <span>02</span>
          <h3 id="quote-review-event-title">Tu evento</h3>
        </div>
        <button type="button" class="quote-text-action" data-quote-edit-step="1">
          Editar <span class="sr-only">información del evento</span>
        </button>
      </header>
      <dl>
        <div><dt>Servicio</dt><dd data-review-value="service"></dd></div>
        <div><dt>Tipo de evento</dt><dd data-review-value="eventType"></dd></div>
        <div><dt>Fecha</dt><dd data-review-value="eventDate"></dd></div>
        <div><dt>Invitados</dt><dd data-review-value="guestRange"></dd></div>
      </dl>
    </section>

    <section class="quote-review__section" aria-labelledby="quote-review-details-title">
      <header>
        <div>
          <span>03</span>
          <h3 id="quote-review-details-title">Cuéntanos un poco más</h3>
        </div>
        <button type="button" class="quote-text-action" data-quote-edit-step="2">
          Editar <span class="sr-only">detalles adicionales</span>
        </button>
      </header>
      <dl>
        <div><dt>Venue</dt><dd data-review-value="venue"></dd></div>
        <div data-review-venue-name hidden>
          <dt>Nombre del venue</dt><dd data-review-value="venueName"></dd>
        </div>
        <div data-review-venue-files hidden>
          <dt>Fotografías</dt><dd data-review-value="venueFiles"></dd>
        </div>
        <div><dt>Presupuesto</dt><dd data-review-value="budget"></dd></div>
        <div class="quote-review__message">
          <dt>Descripción</dt><dd data-review-value="message"></dd>
        </div>
      </dl>
    </section>
  </div>

  <p class="quote-review__notice">
    Al enviar, confirmas que la información anterior es correcta.
  </p>
</section>
