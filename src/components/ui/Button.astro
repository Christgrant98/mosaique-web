---
import type { HTMLAttributes } from "astro/types";

type ButtonVariant = "primary" | "secondary" | "ghost";

interface Props extends HTMLAttributes<"a"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: ButtonVariant;
}

const { href, type = "button", variant = "primary", class: className, ...attrs } = Astro.props;

const baseClass =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-sm border px-5 py-3 text-[length:var(--text-button-size)] font-[var(--text-button-weight)] leading-[var(--text-button-line-height)] tracking-[var(--text-button-letter-spacing)] no-underline transition-[background-color,border-color,color,transform] duration-[var(--motion-duration-fast)] ease-[var(--motion-easing-standard)] hover:-translate-y-0.5 focus-visible:translate-y-0";

const variantClass = {
  primary:
    "border-[color:var(--color-text-primary)] bg-[var(--color-text-primary)] text-[color:var(--color-text-inverse)]",
  secondary:
    "border-[color:var(--color-border-strong)] bg-transparent text-[color:var(--color-text-primary)] hover:bg-[var(--color-surface-muted)]",
  ghost:
    "border-transparent bg-transparent px-0 text-[color:var(--color-text-primary)] underline decoration-[var(--color-border-strong)] hover:text-[color:var(--color-accent)]",
}[variant];
---

{
  href ? (
    <a href={href} class:list={[baseClass, variantClass, className]} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[baseClass, variantClass, className]} {...attrs}>
      <slot />
    </button>
  )
}
