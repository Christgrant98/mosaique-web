---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  align?: "start" | "center" | "end" | "stretch";
  gap?: "micro" | "component" | "content" | "section";
  horizontal?: boolean;
}

const {
  align = "stretch",
  gap = "component",
  horizontal = false,
  class: className,
  ...attrs
} = Astro.props;

const alignClass = {
  start: "items-start",
  center: "items-center",
  end: "items-end",
  stretch: "items-stretch",
}[align];

const gapClass = {
  micro: "gap-[var(--space-micro)]",
  component: "gap-[var(--space-component)]",
  content: "gap-[var(--space-content)]",
  section: "gap-[var(--space-section)]",
}[gap];
---

<div
  class:list={["flex", horizontal ? "flex-row" : "flex-col", alignClass, gapClass, className]}
  {...attrs}
>
  <slot />
</div>
