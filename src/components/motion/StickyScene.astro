---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  stickyClass?: string;
}

const { class: className, stickyClass = "", ...attrs } = Astro.props;
---

<div class:list={["relative", className]} {...attrs}>
  <div
    class:list={[
      "sticky top-[var(--layout-sticky-top)] z-[var(--primitive-z-sticky)]",
      stickyClass,
    ]}
  >
    <slot />
  </div>
</div>
